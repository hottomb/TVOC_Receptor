uint8_t     i2cErrorCount = 0;
static char slowDataStr[80] = "";

// =============================================================================
// STRUKTURY DANYCH ESP-NOW
//
// txPacket — bufor nadawczy współdzielony z WiFi driverem.
//   Lifetime: dane muszą pozostać stabilne od esp_now_send() do OnDataSent().
//   Po OnDataSent() driver nie dotyka bufora — można nadpisać.
//   Globalny: stabilny adres RAM, brak alokacji stosu per-TX.
//   [MUST-2] Inicjalizowany zerem w setup() przez memset() — obszary text_data[]
//   nieobjęte przez snprintf pozostają '\0', nie zawierają śmieciowych bajtów.
//
// peerInfo — konfiguracja peera ESP-NOW.
//   [MUST-1] Inicjalizowany zerem w setup() przez memset() przed wypełnieniem
//   peer_addr/channel/encrypt. Pola lmk[], ifidx, priv wymagają wartości 0
//   dla trybu bez szyfrowania — bez memset mogą zawierać śmieciowe wartości
//   z BSS lub poprzedniej sesji, co może powodować błąd esp_now_add_peer().
// =============================================================================
typedef struct __attribute__((packed)) struct_message {
    uint32_t seq_num;
    uint32_t uptime;
    char     text_data[140];
    uint32_t crc32;
} struct_message;

// {} inicjalizuje wszystkie pola zerem już przy definicji.
// Globalne POD są zerowane przez BSS — ale {} jest jawnym kontraktem:
// działa poprawnie nawet gdyby zmienne zostały przeniesione do zakresu
// lokalnego (np. do FreeRTOS taska), gdzie BSS zerowanie nie obowiązuje.
struct_message      txPacket{};
esp_now_peer_info_t peerInfo{};

// sequenceNumber — dual-storage pattern:
//   rtcSeqNum (RTC_DATA_ATTR): przeżywa deep sleep, zeruje się przy power cycle.
//   sequenceNumber (atomic<uint32_t>): roboczy, ładowany z rtcSeqNum w setup().
//   Synchronizacja rtcSeqNum przy każdym pakiecie (nie tylko przed snem)
//   gwarantuje ciągłość numeracji nawet po nagłym power cycle.
RTC_DATA_ATTR uint32_t rtcSeqNum = 0;
std::atomic<uint32_t>  sequenceNumber(0);

std::atomic<bool>          tx_radio_busy(false);
std::atomic<uint32_t>      dropped_frames(0);
std::atomic<uint8_t>       consecutiveRadioTimeouts(0);
std::atomic<unsigned long> txStartTime(0);

unsigned long txBackoffUntil = 0;

// Wzorzec generacji dla slow data — zastępuje bool slow_dirty.
uint32_t slow_generation      = 0;
uint32_t slow_sent_generation = 0;

// fast_dirty: bool — celowo nie atomic.
// Czytany i pisany wyłącznie w loop(), nigdy w callbacku/ISR.
// Na single-core ESP32-C3 brak race condition. Atomic byłby mylący.
bool fast_dirty = false;

// =============================================================================
// KOLEJKA EVENTÓW PRZYCISKU
// =============================================================================
#define TRIGGER_QUEUE_SIZE 8

static TriggerEvent triggerQueue[TRIGGER_QUEUE_SIZE];
static uint8_t      triggerQueueHead = 0;
static uint8_t      triggerQueueTail = 0;

inline void triggerEnqueue(TriggerEvent evt) {
    uint8_t next = (triggerQueueTail + 1) % TRIGGER_QUEUE_SIZE;
    if (next != triggerQueueHead) {
        triggerQueue[triggerQueueTail] = evt;
        triggerQueueTail = next;
    }
}

inline TriggerEvent triggerDequeue() {
    if (triggerQueueHead == triggerQueueTail) return EVT_NONE;
    TriggerEvent evt = triggerQueue[triggerQueueHead];
    triggerQueueHead = (triggerQueueHead + 1) % TRIGGER_QUEUE_SIZE;
    return evt;
}

inline bool triggerQueueEmpty() {
    return triggerQueueHead == triggerQueueTail;
}

unsigned long ledTurnOffTime  = 0;
unsigned long errorBlinkTimer = 0;
bool          errorLedState   = false;

float    cachedTemp   = 0.0f;
float    cachedRH     = 0.0f;
float    cachedAbsHum = 0.0f;
uint16_t cachedTVOC   = 0;
uint16_t cachedeCO2   = 0;

