float getAbsoluteHumidityFloat(float temperature, float humidity) {
    if (temperature == 0.0f && humidity == 0.0f) return 0.0f;
    return 216.7f * ((humidity / 100.0f) * 6.112f *
           expf((17.62f * temperature) / (243.12f + temperature)) /
           (273.15f + temperature));
}

void enterDeepSleep() {
    esp_task_wdt_reset();
    rtcSeqNum = sequenceNumber.load(std::memory_order_relaxed);
    if (Serial) { Serial.println("\n[SLEEP] Deep Sleep. Wakeup: GPIO1 LOW..."); Serial.flush(); }
    pinMode(BUTTON_PIN_SENSE, INPUT_PULLUP);
    pinMode(BUTTON_PIN_GND,   OUTPUT);
    digitalWrite(BUTTON_PIN_GND, LOW);
    gpio_hold_en((gpio_num_t)BUTTON_PIN_GND);
    gpio_hold_en((gpio_num_t)BUTTON_PIN_SENSE);
    esp_deep_sleep_enable_gpio_wakeup(1ULL << BUTTON_PIN_SENSE, ESP_GPIO_WAKEUP_GPIO_LOW);
    esp_deep_sleep_start();
}

// [SHOULD-1] recoverI2CBus() = wyłącznie bit-bang odblokowywanie magistrali I2C.
// Wire.begin() CELOWO BRAK — caller odpowiada za reinicjalizację:
//   STEP_RECOVER: Wire.begin() + Wire.setTimeOut(50) po tej funkcji
//   RECOVER_I2C:  Wire.begin() w STEP_BEGIN po przejściu do INIT_I2C
// Powód: eliminacja podwójnego Wire.begin() (było: Wire.begin w STEP_BEGIN,
// potem Wire.end w recoverI2CBus, potem Wire.begin w recoverI2CBus — trzy razy).
void recoverI2CBus() {
    if (Serial) Serial.println("\n[CRITICAL] Bit-bang: odblokowywanie I2C...");
    Wire.end();
    pinMode(I2C_SDA, INPUT_PULLUP);
    pinMode(I2C_SCL, OUTPUT);
    for (int i = 0; i < 9; i++) {
        digitalWrite(I2C_SCL, LOW);  delayMicroseconds(10);
        digitalWrite(I2C_SCL, HIGH); delayMicroseconds(10);
        if (digitalRead(I2C_SDA) == HIGH) break;
    }
    pinMode(I2C_SDA, OUTPUT);
    digitalWrite(I2C_SDA, LOW);  delayMicroseconds(10);
    digitalWrite(I2C_SCL, HIGH); delayMicroseconds(10);
    digitalWrite(I2C_SDA, HIGH); delayMicroseconds(10);
    // Wire.begin() NIE jest tu wywoływane — patrz komentarz funkcji
}

void OnDataSent(const uint8_t* mac_addr, esp_now_send_status_t status) {
    tx_radio_busy.store(false, std::memory_order_relaxed);
    if (status == ESP_NOW_SEND_SUCCESS) {
        consecutiveRadioTimeouts.store(0, std::memory_order_relaxed);
    } else {
        dropped_frames.fetch_add(1, std::memory_order_relaxed);
    }
}

// [MUST-3] Pomocnik: inicjalizuje peerInfo zerem i dodaje peera.
// Wspólna logika dla setup() i softRadioReset() — jeden punkt obsługi błędu.
// ESP_ERR_ESPNOW_EXIST: akceptowany jako sukces — peer już istnieje w tabeli.
// Może się zdarzyć po softRadioReset() jeśli esp_now_deinit() nie wyczyściło
// peer table w pełni. Traktowanie EXIST jako błędu powodowałoby fałszywy
// alarm i wejście w SYSTEM_ERROR przy sprawnym działaniu radia.
static bool addEspNowPeer() {
    memset(&peerInfo, 0, sizeof(peerInfo));   // czyści lmk[], ifidx, priv
    memcpy(peerInfo.peer_addr, receiverMAC, 6);
    peerInfo.channel = 1;
    peerInfo.encrypt = false;
    esp_err_t err = esp_now_add_peer(&peerInfo);
    if (err == ESP_OK || err == ESP_ERR_ESPNOW_EXIST) {
        return true; // ESP_ERR_ESPNOW_EXIST = peer już zarejestrowany — OK
    }
    if (Serial) Serial.printf("[ESPNOW] esp_now_add_peer failed: 0x%x\n", err);
    return false;
}

void softRadioReset() {
    if (Serial) Serial.println("[RADIO] Soft reset stosu ESP-NOW/WiFi...");
    esp_now_deinit();
    esp_wifi_stop();
    delay(50);
    esp_wifi_start();
    esp_wifi_set_promiscuous(true);
    esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
    esp_wifi_set_promiscuous(false);
    if (esp_now_init() != ESP_OK) {
        if (Serial) Serial.println("[RADIO] esp_now_init() nieudane — reboot.");
        delay(100); ESP.restart();
    }
    esp_now_register_send_cb(OnDataSent);
    if (!addEspNowPeer()) {
        if (Serial) Serial.println("[RADIO] add_peer nieudane — reboot.");
        delay(100); ESP.restart();
    }
    tx_radio_busy.store(false, std::memory_order_release);
    txStartTime.store(0, std::memory_order_relaxed);
    if (Serial) Serial.println("[RADIO] Soft reset zakończony.");
}

// =============================================================================
// FUNKCJE TX (OPT-2: zastępują goto end_tx_section)
// Zwracają true gdy pakiet przyjęty do nadania, false przy każdym błędzie.
// =============================================================================

static bool sendTriggerPacket(TriggerEvent evt, unsigned long currentMillis) {
    const char* action;
    switch (evt) {
        case EVT_SHORT:    action = "CLICK";    break;
        case EVT_HOLD:     action = "HOLD";     break;
        case EVT_HOLD_END: action = "HOLD_END"; break;
        default:           action = "UNKNOWN";  break;
    }

    uint32_t seqVal = sequenceNumber.fetch_add(1, std::memory_order_relaxed) + 1;
    rtcSeqNum = seqVal;

    int ret = snprintf(txPacket.text_data, sizeof(txPacket.text_data),
                       "SEQ:%u TYPE:TRIGGER ACTION:%s", seqVal, action);
    if (ret < 0 || ret >= (int)sizeof(txPacket.text_data)) {
        dropped_frames.fetch_add(1, std::memory_order_relaxed);
        if (evt == EVT_SHORT || evt == EVT_HOLD_END) triggerEnqueue(evt);
        return false;
    }

    txPacket.seq_num = seqVal;
    txPacket.uptime  = currentMillis;
    txPacket.crc32   = crc32_le(0, (uint8_t*)&txPacket, offsetof(struct_message, crc32));

    tx_radio_busy.store(true, std::memory_order_relaxed);
    txStartTime.store(currentMillis, std::memory_order_relaxed);

    if (esp_now_send(receiverMAC, (uint8_t*)&txPacket, sizeof(txPacket)) == ESP_OK) {
        LED_ON();
        ledTurnOffTime = millis() + (evt == EVT_HOLD ? 30 : 150);
        return true;
    }

    tx_radio_busy.store(false, std::memory_order_relaxed);
    dropped_frames.fetch_add(1, std::memory_order_relaxed);
    txBackoffUntil = millis() + 10;
    if (evt == EVT_SHORT || evt == EVT_HOLD_END) triggerEnqueue(evt);
    return false;
}

static bool sendTVOCPacket(unsigned long currentMillis) {
    bool hasNewSlowData = (slow_generation != slow_sent_generation);

    if (hasNewSlowData) {
        int ret = snprintf(slowDataStr, sizeof(slowDataStr),
                           "T:%.2f RH:%.2f AH:%.2f TVOC:%u CO2:%u ",
                           cachedTemp, cachedRH, cachedAbsHum, cachedTVOC, cachedeCO2);
        if (ret < 0 || ret >= (int)sizeof(slowDataStr)) {
            if (Serial) Serial.printf("[WARN] slowDataStr snprintf failed ret=%d\n", ret);
            slowDataStr[0] = '\0';
            slow_sent_generation = slow_generation; // Porzuć — nie próbuj ponownie
            dropped_frames.fetch_add(1, std::memory_order_relaxed);
            return false;
        }
    }

    uint32_t seqVal = sequenceNumber.fetch_add(1, std::memory_order_relaxed) + 1;
    rtcSeqNum = seqVal;

    int ret = snprintf(txPacket.text_data, sizeof(txPacket.text_data),
                       "S:%u %srH2:%u rEtOH:%u",
                       seqVal, slowDataStr, sgp.rawH2, sgp.rawEthanol);
    if (ret < 0 || ret >= (int)sizeof(txPacket.text_data)) {
        dropped_frames.fetch_add(1, std::memory_order_relaxed);
        if (Serial) Serial.printf("[WARN] TVOC snprintf failed ret=%d\n", ret);
        return false;
    }

    txPacket.seq_num = seqVal;
    txPacket.uptime  = currentMillis;
    txPacket.crc32   = crc32_le(0, (uint8_t*)&txPacket, offsetof(struct_message, crc32));

    tx_radio_busy.store(true, std::memory_order_relaxed);
    txStartTime.store(currentMillis, std::memory_order_relaxed);

    if (esp_now_send(receiverMAC, (uint8_t*)&txPacket, sizeof(txPacket)) == ESP_OK) {
        LED_ON();
        ledTurnOffTime = millis() + 10;
        if (hasNewSlowData) slow_sent_generation = slow_generation;
        return true;
    }

    tx_radio_busy.store(false, std::memory_order_relaxed);
    dropped_frames.fetch_add(1, std::memory_order_relaxed);
    txBackoffUntil = millis() + 10;
    // slow_sent_generation NIE aktualizowany → retry slow data przy kolejnym TX
    return false;
}

// =============================================================================
// POLLING PRZYCISKU
// =============================================================================
void pollButton(unsigned long currentMillis) {
    enum BtnState { BTN_IDLE, BTN_DEBOUNCE, BTN_PRESSED, BTN_LONG_HOLD, BTN_RELEASE_WAIT };
    static BtnState      btnState      = BTN_IDLE;
    static bool          lastRawState  = HIGH;
    static bool          initialized   = false;
    static unsigned long debounceStart = 0;
    static unsigned long pressStart    = 0;
    static unsigned long lastHoldSend  = 0;
    const  unsigned long DEBOUNCE_MS   = 30;

    if (!initialized) {
        lastRawState = digitalRead(BUTTON_PIN_SENSE);
        if (esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_GPIO && lastRawState == LOW) {
            btnState   = BTN_PRESSED;
            pressStart = 0;
            if (Serial) Serial.println("[BTN] Wznowienie PRESSED z Deep Sleep");
        }
        initialized = true;
    }

    bool rawNow = digitalRead(BUTTON_PIN_SENSE);

    switch (btnState) {
        case BTN_IDLE:
            if (rawNow == LOW && lastRawState == HIGH) {
                debounceStart = currentMillis;
                btnState      = BTN_DEBOUNCE;
            }
            break;
        case BTN_DEBOUNCE:
            if (rawNow == HIGH) {
                btnState = BTN_IDLE;
            } else if (currentMillis - debounceStart >= DEBOUNCE_MS) {
                pressStart   = currentMillis;
                lastHoldSend = currentMillis;
                btnState     = BTN_PRESSED;
                if (Serial) Serial.println("\n>>> GUZIK WCIŚNIĘTY <<<");
            }
            break;
        case BTN_PRESSED:
            if (rawNow == HIGH) {
                triggerEnqueue(EVT_SHORT);
                if (Serial) Serial.println("[BTN] SHORT PRESS");
                debounceStart = currentMillis;
                btnState      = BTN_RELEASE_WAIT;
            } else if (currentMillis - pressStart >= LONG_PRESS_THRESHOLD_MS) {
                btnState     = BTN_LONG_HOLD;
                if (Serial) Serial.println("[BTN] LONG PRESS START");
                triggerEnqueue(EVT_HOLD);
                lastHoldSend = currentMillis;
            }
            break;
        case BTN_LONG_HOLD:
            if (rawNow == HIGH) {
                triggerEnqueue(EVT_HOLD_END);
                if (Serial) Serial.println("[BTN] HOLD END");
                debounceStart = currentMillis;
                btnState      = BTN_RELEASE_WAIT;
            } else if (currentMillis - lastHoldSend >= LONG_PRESS_INTERVAL_MS) {
                triggerEnqueue(EVT_HOLD);
                lastHoldSend = currentMillis;
            }
            break;
        case BTN_RELEASE_WAIT:
            if (rawNow == LOW) {
                debounceStart = currentMillis;
            } else if (currentMillis - debounceStart >= DEBOUNCE_MS) {
                btnState = BTN_IDLE;
            }
            break;
        default:
            btnState = BTN_IDLE;
            break;
    }
    lastRawState = rawNow;
}

// =============================================================================
// SETUP
// =============================================================================
void setup() {
    Serial.begin(500000);

    // [OPT-3] Powód ostatniego restartu — diagnostyka w terenie.
    if (Serial) {
        const char* r;
        switch (esp_reset_reason()) {
            case ESP_RST_POWERON:  r = "POWER_ON";  break;
            case ESP_RST_SW:       r = "SW_RESET";  break;
            case ESP_RST_PANIC:    r = "PANIC";     break;
            case ESP_RST_INT_WDT:  r = "INT_WDT";   break;
            case ESP_RST_TASK_WDT: r = "TASK_WDT";  break;
            case ESP_RST_WDT:      r = "WDT";       break;
            case ESP_RST_BROWNOUT: r = "BROWNOUT";  break;
            default:               r = "UNKNOWN";   break;
        }
        Serial.printf("\n[BOOT] v1.12 | Reset: %s\n", r);
    }

    gpio_hold_dis((gpio_num_t)BUTTON_PIN_GND);
    gpio_hold_dis((gpio_num_t)BUTTON_PIN_SENSE);

    sequenceNumber.store(rtcSeqNum, std::memory_order_relaxed);

    // [MUST-1,2] Jawna inicjalizacja zerem przed pierwszym użyciem
    memset(&txPacket, 0, sizeof(txPacket));
    memset(&peerInfo, 0, sizeof(peerInfo));

    WiFi.mode(WIFI_STA);
    esp_wifi_set_promiscuous(true);
    esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
    esp_wifi_set_promiscuous(false);
    WiFi.setTxPower(WIFI_POWER_8_5dBm);

    pinMode(LED_PIN,          OUTPUT); LED_OFF();
    pinMode(BUTTON_PIN_GND,   OUTPUT); digitalWrite(BUTTON_PIN_GND, LOW);
    pinMode(BUTTON_PIN_SENSE, INPUT_PULLUP);

    esp_task_wdt_init(WDT_TIMEOUT_SEC, true);
    esp_task_wdt_add(NULL);

    if (esp_now_init() != ESP_OK) {
        if (Serial) Serial.println("[FATAL] esp_now_init() failed!");
        currentState = SYSTEM_ERROR;
    } else {
        esp_now_register_send_cb(OnDataSent);
        // [MUST-3] Wynik addEspNowPeer() sprawdzany — brak peera = brak TX
        if (!addEspNowPeer()) {
            if (Serial) Serial.println("[FATAL] esp_now_add_peer() failed!");
            currentState = SYSTEM_ERROR;
        } else {
            currentState = (myRole == ROLE_TRIGGER_ONLY) ? RUNNING : INIT_I2C;
        }
    }
}

// =============================================================================
// GŁÓWNA PĘTLA
// =============================================================================
void loop() {
    unsigned long currentMillis = millis();
    esp_task_wdt_reset();

    if (ledTurnOffTime > 0 && currentMillis >= ledTurnOffTime) {
        LED_OFF();
        ledTurnOffTime = 0;
    }

    pollButton(currentMillis);

    switch (currentState) {
        case INIT_I2C:
            switch (initStep) {
                case STEP_BEGIN:
                    // [SHOULD-1] Wire.begin() tutaj — recoverI2CBus() go nie wywołuje
                    Wire.begin(I2C_SDA, I2C_SCL);
                    Wire.setTimeOut(50);
                    if (shtc2.begin(&Wire) && sgp.begin(&Wire)) {
                        if (Serial) Serial.println("\n[OK] I2C OK. Tryb: SENSOR + GUZIK.");
                        myRole         = ROLE_SENSOR_AND_TRIGGER;
                        stateStartTime = currentMillis;
                        initStep       = STEP_DONE;
                        currentState   = WARMUP;
                    } else {
                        initStep = STEP_RECOVER;
                    }
                    break;
                case STEP_RECOVER:
                    recoverI2CBus(); // bit-bang only
                    // [SHOULD-1] Wire.begin() po bit-bang, przed STEP_RETRY
                    Wire.begin(I2C_SDA, I2C_SCL);
                    Wire.setTimeOut(50);
                    initStep = STEP_RETRY;
                    break;
                case STEP_RETRY:
                    if (shtc2.begin(&Wire) && sgp.begin(&Wire)) {
                        if (Serial) Serial.println("\n[OK] I2C OK po recovery. Tryb: SENSOR + GUZIK.");
                        myRole         = ROLE_SENSOR_AND_TRIGGER;
                        stateStartTime = currentMillis;
                        initStep       = STEP_DONE;
                        currentState   = WARMUP;
                    } else {
                        if (Serial) Serial.println("\n[INFO] Brak I2C. Tryb: TYLKO GUZIK.");
                        myRole       = ROLE_TRIGGER_ONLY;
                        initStep     = STEP_DONE;
                        currentState = RUNNING;
                    }
                    break;
                case STEP_DONE:
                    break;
            }
            break;

        case WARMUP:
            if (currentMillis - stateStartTime >= WARMUP_DURATION) {
                currentState       = RUNNING;
                previousFastMillis = currentMillis;
                previousSlowMillis = currentMillis;
            } else {
                if (currentMillis - previousSlowMillis >= slowInterval) {
                    previousSlowMillis = currentMillis;
                    sensors_event_t humidity, temp;
                    shtc2.getEvent(&humidity, &temp);
                    sgp.setHumidity(static_cast<uint32_t>(
                        getAbsoluteHumidityFloat(temp.temperature,
                                                 humidity.relative_humidity) * 256.0f));
                    sgp.IAQmeasure();
                    if (Serial) {
                        Serial.print("\rRozgrzewanie MOX... Pozostało: ");
                        Serial.print((WARMUP_DURATION - (currentMillis - stateStartTime)) / 1000);
                        Serial.print("s   ");
                    }
                }
            }
            break;

        case RECOVER_I2C:
            recoverI2CBus(); // bit-bang only — Wire.begin() w STEP_BEGIN po przejściu
            initStep     = STEP_BEGIN;
            currentState = INIT_I2C;
            break;

        case SYSTEM_ERROR:
            if (currentMillis - errorBlinkTimer > 200) {
                errorBlinkTimer = currentMillis;
                errorLedState   = !errorLedState;
                digitalWrite(LED_PIN, errorLedState ? LOW : HIGH);
            }
            break;

        case RUNNING:
            if (myRole == ROLE_SENSOR_AND_TRIGGER) {
                // SLOW LOOP — 1 Hz
                if (currentMillis - previousSlowMillis >= slowInterval) {
                    if (slow_generation != slow_sent_generation)
                        dropped_frames.fetch_add(1, std::memory_order_relaxed);
                    previousSlowMillis = currentMillis;
                    sensors_event_t humidity, temp;
                    if (shtc2.getEvent(&humidity, &temp)) {
                        cachedTemp   = temp.temperature;
                        cachedRH     = humidity.relative_humidity;
                        cachedAbsHum = getAbsoluteHumidityFloat(cachedTemp, cachedRH);
                        sgp.setHumidity(static_cast<uint32_t>(cachedAbsHum * 256.0f));
                        if (sgp.IAQmeasure()) {
                            cachedTVOC    = sgp.TVOC;
                            cachedeCO2    = sgp.eCO2;
                            slow_generation++;
                            i2cErrorCount = 0;
                        } else { i2cErrorCount++; }
                    } else { i2cErrorCount++; }
                }
                // FAST LOOP — 5 Hz
                if (currentMillis - previousFastMillis >= fastInterval) {
                    if (fast_dirty) dropped_frames.fetch_add(1, std::memory_order_relaxed);
                    previousFastMillis = currentMillis;
                    if (!sgp.IAQmeasureRaw()) {
                        i2cErrorCount++;
                    } else {
                        i2cErrorCount = 0;
                        fast_dirty    = true;
                    }
                    if (i2cErrorCount >= I2C_ERROR_LIMIT) {
                        currentState  = RECOVER_I2C;
                        i2cErrorCount = 0;
                    }
                }
            }
            break;
    }

    // =========================================================================
    // WATCHDOG RADIA
    // =========================================================================
    if (tx_radio_busy.load(std::memory_order_acquire) &&
        (currentMillis - txStartTime.load(std::memory_order_relaxed) > 500)) {

        dropped_frames.fetch_add(1, std::memory_order_relaxed);
        uint8_t timeouts = consecutiveRadioTimeouts.fetch_add(1, std::memory_order_relaxed) + 1;

        if (timeouts >= 5) {
            if (Serial) { Serial.println("[FATAL] 5 timeoutów — hard restart."); delay(100); }
            ESP.restart();
        } else {
            if (Serial) Serial.printf("[RADIO] TX Timeout #%u — soft reset.\n", timeouts);
            softRadioReset();
            txBackoffUntil = currentMillis + 50;
        }
    }

    // =========================================================================
    // SEKCJA TRANSMISJI ESP-NOW
    // =========================================================================
    if (!tx_radio_busy.load(std::memory_order_relaxed) && currentMillis >= txBackoffUntil) {

        TriggerEvent evt = triggerDequeue();

        if (evt != EVT_NONE) {
            sendTriggerPacket(evt, currentMillis);

        } else if (myRole == ROLE_SENSOR_AND_TRIGGER &&
                   currentState == RUNNING &&
                   (fast_dirty || (slow_generation != slow_sent_generation))) {

            sendTVOCPacket(currentMillis);
            fast_dirty = false;
        }
    }

    // =========================================================================
    // DEEP SLEEP
    // =========================================================================
    if (myRole == ROLE_TRIGGER_ONLY && currentState == RUNNING) {
        if (!tx_radio_busy.load(std::memory_order_relaxed) &&
            triggerQueueEmpty() &&
            currentMillis >= txBackoffUntil) {
            if (ledTurnOffTime == 0 || currentMillis >= ledTurnOffTime) {
                enterDeepSleep();
            }
        }
    }
}
