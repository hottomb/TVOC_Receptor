// =============================================================================
// Sonda TVOC / Trigger — ESP32-C3 Supermini (ESP32C3FN4)
// Procesor: RISC-V 32-bit single-core, do 160 MHz, 400KB SRAM, 4MB Flash
//
// CHANGELOG v1.7 (Final Polish):
//   [1] Fix K-1: pressStart przy wybudzeniu z Deep Sleep jest ustawiane na 0. 
//       Kompensuje to czas bootowania i inicjalizacji, idealnie odmierzając 1s LONG_PRESS.
//   [2] Fix P-1: txBackoffUntil aplikowane na WSZYSTKIE błędy radia (w tym EVT_HOLD),
//       zapobiegając uderzaniu w sprzęt bez cooldownu po zgubieniu strumienia.
//   [3] Fix P-2: Deep sleep warunkowany zakończeniem txBackoffUntil.
//   [4] Przywrócono wydruk postępu WARMUP (U-1).
//   [5] Dodano dokumentację (U-3 i U-4) dotyczącą aktywnego przycisku w czasie WARMUP
//       oraz współdzielonego numeru sekwencyjnego dla chronologii logów ML.

//    Single-Owner VFS na bazie — jeden task jako jedyny właściciel uchwytu pliku eliminuje całą klasę błędów race condition na FAT32 bez potrzeby skomplikowanych blokad per-operacja.
//    Parsowanie EVENT_TYPE przez strstr zamiast pola w strukturze — pozwoliło zachować kompatybilność binarną z nadajnikiem bez żadnych zmian firmware sondy. Struktura jako kontrakt nie została złamana.
//    pressStart = 0 jako kompensacja boot-time — eleganckie rozwiązanie problemu niemierzalności czasu wciśnięcia przed startem systemu, które nie wymaga zegara RTC ani persystencji między sesjami.
//    Kolejka eventów zamiast licznika/flagi — umożliwiła naturalną obsługę zarówno short jak i long press bez zmiany architektury sekcji TX, zachowując priorytety i FIFO ordering.
// =============================================================================

#include <Arduino.h>
#include <Wire.h>
#include <esp_now.h>
#include <WiFi.h>
#include <esp_wifi.h>
#include <esp_task_wdt.h>
#include <esp_sleep.h>
#include "driver/gpio.h"    
#include <rom/crc.h>
#include <atomic>
#include "Adafruit_SGP30.h"
#include "Adafruit_SHTC3.h"

// =============================================================================
// KONFIGURACJA SPRZĘTOWA
// =============================================================================
#define I2C_SDA           3
#define I2C_SCL           4
#define WDT_TIMEOUT_SEC   5
#define I2C_ERROR_LIMIT   5

#define LED_PIN           8
#define LED_ON()  digitalWrite(LED_PIN, LOW)
#define LED_OFF() digitalWrite(LED_PIN, HIGH)

#define BUTTON_PIN_SENSE  1
#define BUTTON_PIN_GND    2

uint8_t receiverMAC[] = {0xAC, 0x67, 0xB2, 0x1B, 0xE0, 0xC0};

// =============================================================================
// KONFIGURACJA PRZYCISKU
// =============================================================================
#define LONG_PRESS_THRESHOLD_MS  1000UL
#define LONG_PRESS_INTERVAL_MS    150UL

enum TriggerEvent : uint8_t {
    EVT_NONE      = 0,
    EVT_SHORT     = 1,   
    EVT_HOLD      = 2,   
    EVT_HOLD_END  = 3,   
};

// =============================================================================
// OBIEKTY CZUJNIKÓW & ROLE
// =============================================================================
Adafruit_SGP30  sgp;
Adafruit_SHTC3  shtc2 = Adafruit_SHTC3();

enum NodeRole { ROLE_UNKNOWN, ROLE_SENSOR_AND_TRIGGER, ROLE_TRIGGER_ONLY };
RTC_DATA_ATTR NodeRole myRole = ROLE_UNKNOWN;

enum SystemState { INIT_I2C, WARMUP, RUNNING, RECOVER_I2C, SYSTEM_ERROR };
SystemState   currentState   = INIT_I2C;
unsigned long stateStartTime = 0;

const long WARMUP_DURATION = 15000; 

enum InitI2CStep { STEP_BEGIN, STEP_RECOVER, STEP_RETRY, STEP_DONE };
InitI2CStep initStep = STEP_BEGIN;

unsigned long previousFastMillis = 0;
const long    fastInterval       = 200;  

unsigned long previousSlowMillis = 0;
const long    slowInterval       = 1000; 

uint8_t       i2cErrorCount      = 0;
static char   slowDataStr[80]    = "";

// =============================================================================
// STRUKTURY DANYCH ESP-NOW
// UWAGA: seq_num jest wspólny dla eventów przycisku i odczytów TVOC (U-4).
// Zapewnia to idealną weryfikację chronologii zdarzeń w plikach CSV przy ML.
// =============================================================================
typedef struct __attribute__((packed)) struct_message {
    uint32_t seq_num;
    uint32_t uptime;
    char     text_data[140];
    uint32_t crc32;
} struct_message;

struct_message      txPacket;
esp_now_peer_info_t peerInfo;

RTC_DATA_ATTR uint32_t sequenceNumber = 0;

std::atomic<bool>     tx_radio_busy(false);
std::atomic<uint32_t> dropped_frames(0);

unsigned long txBackoffUntil = 0;

// =============================================================================
// KOLEJKA EVENTÓW PRZYCISKU
// =============================================================================
#define TRIGGER_QUEUE_SIZE 8

static TriggerEvent triggerQueue[TRIGGER_QUEUE_SIZE];
static uint8_t      triggerQueueHead = 0;
static uint8_t      triggerQueueTail = 0;

inline void triggerEnqueue(TriggerEvent evt) {
    uint8_t next = (triggerQueueTail + 1) % TRIGGER_QUEUE_SIZE;
    if (next != triggerQueueHead) { 
        triggerQueue[triggerQueueTail] = evt;
        triggerQueueTail = next;
    }
}

inline TriggerEvent triggerDequeue() {
    if (triggerQueueHead == triggerQueueTail) return EVT_NONE;
    TriggerEvent evt = triggerQueue[triggerQueueHead];
    triggerQueueHead = (triggerQueueHead + 1) % TRIGGER_QUEUE_SIZE;
    return evt;
}

inline bool triggerQueueEmpty() {
    return triggerQueueHead == triggerQueueTail;
}

bool slow_dirty = false;
bool fast_dirty = false;

unsigned long ledTurnOffTime  = 0;
unsigned long errorBlinkTimer = 0;
bool          errorLedState   = false;

float    cachedTemp   = 0.0f;
float    cachedRH     = 0.0f;
float    cachedAbsHum = 0.0f;
uint16_t cachedTVOC   = 0;
uint16_t cachedeCO2   = 0;

// =============================================================================
// FUNKCJE POMOCNICZE
// =============================================================================
float getAbsoluteHumidityFloat(float temperature, float humidity) {
    if (temperature == 0.0f && humidity == 0.0f) return 0.0f;
    return 216.7f * ((humidity / 100.0f) * 6.112f *
           expf((17.62f * temperature) / (243.12f + temperature)) /
           (273.15f + temperature));
}

void enterDeepSleep() {
    esp_task_wdt_reset();
    if (Serial) {
        Serial.println("\n[SLEEP] Deep Sleep. Wakeup: GPIO1 LOW...");
        Serial.flush();
    }
    pinMode(BUTTON_PIN_SENSE, INPUT_PULLUP);
    pinMode(BUTTON_PIN_GND,   OUTPUT);
    digitalWrite(BUTTON_PIN_GND, LOW);

    gpio_hold_en((gpio_num_t)BUTTON_PIN_GND);
    gpio_hold_en((gpio_num_t)BUTTON_PIN_SENSE);

    esp_deep_sleep_enable_gpio_wakeup(1ULL << BUTTON_PIN_SENSE, ESP_GPIO_WAKEUP_GPIO_LOW);
    esp_deep_sleep_start();
}

void recoverI2CBus() {
    if (Serial) Serial.println("\n[CRITICAL] Bit-bang: odblokowywanie I2C...");
    Wire.end();
    pinMode(I2C_SDA, INPUT_PULLUP);
    pinMode(I2C_SCL, OUTPUT);
    for (int i = 0; i < 9; i++) {
        digitalWrite(I2C_SCL, LOW);  delayMicroseconds(10);
        digitalWrite(I2C_SCL, HIGH); delayMicroseconds(10);
        if (digitalRead(I2C_SDA) == HIGH) break;
    }
    pinMode(I2C_SDA, OUTPUT);
    digitalWrite(I2C_SDA, LOW);  delayMicroseconds(10);
    digitalWrite(I2C_SCL, HIGH); delayMicroseconds(10);
    digitalWrite(I2C_SDA, HIGH); delayMicroseconds(10);
    Wire.begin(I2C_SDA, I2C_SCL);
}

void OnDataSent(const uint8_t* mac_addr, esp_now_send_status_t status) {
    tx_radio_busy.store(false, std::memory_order_relaxed);
    if (status != ESP_NOW_SEND_SUCCESS) {
        dropped_frames.fetch_add(1, std::memory_order_relaxed);
    }
}

// =============================================================================
// POLLING PRZYCISKU 
// =============================================================================
void pollButton(unsigned long currentMillis) {
    enum BtnState { BTN_IDLE, BTN_DEBOUNCE, BTN_PRESSED, BTN_LONG_HOLD, BTN_RELEASE_WAIT };
    static BtnState      btnState        = BTN_IDLE;
    static bool          lastRawState    = HIGH; 
    static bool          initialized     = false;
    static unsigned long debounceStart   = 0;
    static unsigned long pressStart      = 0;
    static unsigned long lastHoldSend    = 0;
    const  unsigned long DEBOUNCE_MS     = 30;

    if (!initialized) {
        lastRawState = digitalRead(BUTTON_PIN_SENSE);
        
        // FIX K-1: Kompensacja czasu bootowania dla idealnego odwzorowania 1s LONG_PRESS
        if (esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_GPIO && lastRawState == LOW) {
            btnState = BTN_PRESSED;
            pressStart = 0; 
            // Sprzętowe obudzenie = twardy czas T=0 fizycznego wciśnięcia
            // KONTRAKT: setup() musi zakończyć się w czasie < LONG_PRESS_THRESHOLD_MS (1000ms).
            // Jeśli kiedykolwiek setup() zostanie rozbudowany o blokujące operacje,
            // należy albo zwiększyć LONG_PRESS_THRESHOLD_MS,
            // albo zastąpić 0 przez millis() tracąc kompensację boot-time.
            if (Serial) Serial.println("[BTN] Wznowienie PRESSED z Deep Sleep (Kompensacja boot-time)");
        }
        initialized = true;
    }


    bool rawNow = digitalRead(BUTTON_PIN_SENSE);

    switch (btnState) {
        case BTN_IDLE:
            if (rawNow == LOW && lastRawState == HIGH) {
                debounceStart = currentMillis;
                btnState      = BTN_DEBOUNCE;
            }
            break;

        case BTN_DEBOUNCE:
            if (rawNow == HIGH) {
                btnState = BTN_IDLE;
            } else if (currentMillis - debounceStart >= DEBOUNCE_MS) {
                pressStart = currentMillis;
                lastHoldSend = currentMillis;
                btnState   = BTN_PRESSED;
                if (Serial) Serial.println("\n>>> GUZIK WCIŚNIĘTY <<<");
            }
            break;

        case BTN_PRESSED:
            if (rawNow == HIGH) {
                triggerEnqueue(EVT_SHORT);
                if (Serial) Serial.println("[BTN] SHORT PRESS");
                debounceStart = currentMillis;
                btnState = BTN_RELEASE_WAIT; 
            } else if (currentMillis - pressStart >= LONG_PRESS_THRESHOLD_MS) {
                btnState = BTN_LONG_HOLD;
                if (Serial) Serial.println("[BTN] LONG PRESS START");
                triggerEnqueue(EVT_HOLD);
                lastHoldSend = currentMillis;
            }
            break;

        case BTN_LONG_HOLD:
            if (rawNow == HIGH) {
                triggerEnqueue(EVT_HOLD_END);
                if (Serial) Serial.println("[BTN] HOLD END");
                debounceStart = currentMillis;
                btnState = BTN_RELEASE_WAIT; 
            } else if (currentMillis - lastHoldSend >= LONG_PRESS_INTERVAL_MS) {
                triggerEnqueue(EVT_HOLD);
                lastHoldSend = currentMillis;
            }
            break;

        case BTN_RELEASE_WAIT:
            if (rawNow == LOW) {
                debounceStart = currentMillis; 
            } else if (currentMillis - debounceStart >= DEBOUNCE_MS) {
                btnState = BTN_IDLE; 
            }
            break;

        default:
            btnState = BTN_IDLE;
            break;
    }

    lastRawState = rawNow;
}

// =============================================================================
// SETUP
// =============================================================================
void setup() {
    Serial.begin(500000);

    gpio_hold_dis((gpio_num_t)BUTTON_PIN_GND);
    gpio_hold_dis((gpio_num_t)BUTTON_PIN_SENSE);

    WiFi.mode(WIFI_STA);
    esp_wifi_set_promiscuous(true);
    esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
    esp_wifi_set_promiscuous(false);
    
    WiFi.setTxPower(WIFI_POWER_8_5dBm);

    pinMode(LED_PIN,          OUTPUT); LED_OFF();
    pinMode(BUTTON_PIN_GND,   OUTPUT); digitalWrite(BUTTON_PIN_GND, LOW);
    pinMode(BUTTON_PIN_SENSE, INPUT_PULLUP);

    esp_task_wdt_init(WDT_TIMEOUT_SEC, true);
    esp_task_wdt_add(NULL);

    if (esp_now_init() != ESP_OK) {
        if (Serial) Serial.println("[FATAL] esp_now_init() failed!");
        currentState = SYSTEM_ERROR;
    } else {
        esp_now_register_send_cb(OnDataSent);
        memcpy(peerInfo.peer_addr, receiverMAC, 6);
        peerInfo.channel = 1; 
        peerInfo.encrypt = false;
        esp_now_add_peer(&peerInfo);

        currentState = (myRole == ROLE_TRIGGER_ONLY) ? RUNNING : INIT_I2C;
    }
}

// =============================================================================
// GŁÓWNA PĘTLA
// =============================================================================
void loop() {
    unsigned long currentMillis = millis();
    esp_task_wdt_reset();

    if (ledTurnOffTime > 0 && currentMillis >= ledTurnOffTime) {
        LED_OFF();
        ledTurnOffTime = 0;
    }

    pollButton(currentMillis);

    switch (currentState) {
        case INIT_I2C:
            switch (initStep) {
                case STEP_BEGIN:
                    Wire.begin(I2C_SDA, I2C_SCL);
                    if (shtc2.begin(&Wire) && sgp.begin(&Wire)) {
                        if (Serial) Serial.println("\n[OK] I2C OK. Tryb: SENSOR + GUZIK.");
                        myRole         = ROLE_SENSOR_AND_TRIGGER;
                        stateStartTime = currentMillis;
                        initStep       = STEP_DONE;
                        currentState   = WARMUP;
                    } else {
                        initStep = STEP_RECOVER;
                    }
                    break;
                case STEP_RECOVER:
                    recoverI2CBus();
                    initStep = STEP_RETRY;
                    break;
                case STEP_RETRY:
                    if (shtc2.begin(&Wire) && sgp.begin(&Wire)) {
                        if (Serial) Serial.println("\n[OK] I2C OK po recovery.");
                        myRole         = ROLE_SENSOR_AND_TRIGGER;
                        stateStartTime = currentMillis;
                        initStep       = STEP_DONE;
                        currentState   = WARMUP;
                    } else {
                        if (Serial) Serial.println("\n[INFO] Brak I2C. Tryb: TYLKO GUZIK.");
                        myRole       = ROLE_TRIGGER_ONLY;
                        initStep     = STEP_DONE;
                        currentState = RUNNING;
                    }
                    break;
                case STEP_DONE:
                    break;
            }
            break;

        case WARMUP:
            // UWAGA (U-3): W czasie WARMUP pętla nie blokuje działania sekcji TX (ESP-NOW).
            // Jest to w 100% celowe. Naciśnięcie przycisku przez operatora musi
            // natychmiast wygenerować kotwicę ML, nawet jeśli czujniki jeszcze się stabilizują.
            if (currentMillis - stateStartTime >= WARMUP_DURATION) {
                currentState       = RUNNING;
                previousFastMillis = currentMillis;
                previousSlowMillis = currentMillis;
            } else {
                if (currentMillis - previousSlowMillis >= slowInterval) {
                    previousSlowMillis = currentMillis;
                    sensors_event_t humidity, temp;
                    shtc2.getEvent(&humidity, &temp);
                    sgp.setHumidity(static_cast<uint32_t>(
                        getAbsoluteHumidityFloat(temp.temperature, humidity.relative_humidity) * 256.0f));
                    sgp.IAQmeasure();
                    
                    // U-1 FIX: Przywrócono logowanie postępu WARMUP dla celów diagnostycznych
                    if (Serial) {
                        Serial.print("\rRozgrzewanie MOX... Pozostało: ");
                        Serial.print((WARMUP_DURATION - (currentMillis - stateStartTime)) / 1000);
                        Serial.print("s   ");
                    }
                }
            }
            break;

        case RECOVER_I2C:
            recoverI2CBus();
            initStep     = STEP_BEGIN; 
            currentState = INIT_I2C;
            break;

        case SYSTEM_ERROR:
            if (currentMillis - errorBlinkTimer > 200) {
                errorBlinkTimer = currentMillis;
                errorLedState   = !errorLedState;
                digitalWrite(LED_PIN, errorLedState ? LOW : HIGH);
            }
            break;

        case RUNNING:
            if (myRole == ROLE_SENSOR_AND_TRIGGER) {

                if (currentMillis - previousSlowMillis >= slowInterval) {
                    if (slow_dirty) dropped_frames.fetch_add(1, std::memory_order_relaxed);
                    previousSlowMillis = currentMillis;
                    sensors_event_t humidity, temp;
                    if (shtc2.getEvent(&humidity, &temp)) {
                        cachedTemp   = temp.temperature;
                        cachedRH     = humidity.relative_humidity;
                        cachedAbsHum = getAbsoluteHumidityFloat(cachedTemp, cachedRH);
                        sgp.setHumidity(static_cast<uint32_t>(cachedAbsHum * 256.0f));
                        if (sgp.IAQmeasure()) {
                            cachedTVOC    = sgp.TVOC;
                            cachedeCO2    = sgp.eCO2;
                            slow_dirty    = true;
                            i2cErrorCount = 0;
                        } else {
                            i2cErrorCount++;
                        }
                    } else {
                        i2cErrorCount++;
                    }
                }

                if (currentMillis - previousFastMillis >= fastInterval) {
                    if (fast_dirty) dropped_frames.fetch_add(1, std::memory_order_relaxed);
                    previousFastMillis = currentMillis;
                    if (!sgp.IAQmeasureRaw()) {
                        i2cErrorCount++;
                    } else {
                        i2cErrorCount = 0;
                        fast_dirty    = true;
                    }
                    if (i2cErrorCount >= I2C_ERROR_LIMIT) {
                        currentState  = RECOVER_I2C;
                        i2cErrorCount = 0;
                    }
                }
            }
            break;
    }

    // =========================================================================
    // SEKCJA TRANSMISJI ESP-NOW
    // =========================================================================
    
    if (!tx_radio_busy.load(std::memory_order_relaxed) && currentMillis >= txBackoffUntil) {

        TriggerEvent evt = triggerDequeue();

        if (evt != EVT_NONE) {
            const char* action;
            switch (evt) {
                case EVT_SHORT:    action = "CLICK";    break;
                case EVT_HOLD:     action = "HOLD";     break;
                case EVT_HOLD_END: action = "HOLD_END"; break;
                default:           action = "UNKNOWN";  break;
            }

            sequenceNumber++;
            txPacket.seq_num = sequenceNumber;
            txPacket.uptime  = currentMillis;

            int ret = snprintf(txPacket.text_data, sizeof(txPacket.text_data),
                               "SEQ:%u TYPE:TRIGGER ACTION:%s", sequenceNumber, action);
            if (ret < 0 || ret >= (int)sizeof(txPacket.text_data)) {
                dropped_frames.fetch_add(1, std::memory_order_relaxed);
                txPacket.text_data[0] = '\0';
            }

            txPacket.crc32 = crc32_le(0, (uint8_t*)&txPacket, offsetof(struct_message, crc32));

            tx_radio_busy.store(true, std::memory_order_relaxed);
            if (esp_now_send(receiverMAC, (uint8_t*)&txPacket, sizeof(txPacket)) == ESP_OK) {
                LED_ON();
                ledTurnOffTime = millis() + (evt == EVT_HOLD ? 30 : 150);
            } else {
                tx_radio_busy.store(false, std::memory_order_relaxed);
                dropped_frames.fetch_add(1, std::memory_order_relaxed);
                
                // P-1 FIX: txBackoff aplikowane asymetrycznie do wszystkich błędów radia
                txBackoffUntil = currentMillis + 10; 
                
                // EVT_HOLD nie jest retransmitowane (tylko bieżący stan strumienia)
                if (evt == EVT_SHORT || evt == EVT_HOLD_END) {
                    triggerEnqueue(evt);
                }
            }

        } else if (myRole == ROLE_SENSOR_AND_TRIGGER &&
                   currentState == RUNNING &&
                   (fast_dirty || slow_dirty)) {

            bool usedSlowData = false;
            if (slow_dirty) {
                int ret = snprintf(slowDataStr, sizeof(slowDataStr),
                                   "T:%.2f RH:%.2f AH:%.2f TVOC:%u CO2:%u ",
                                   cachedTemp, cachedRH, cachedAbsHum,
                                   cachedTVOC, cachedeCO2);
                if (ret < 0 || ret >= (int)sizeof(slowDataStr)) {
                    slowDataStr[0] = '\0';
                }
                usedSlowData = true;
            }

            sequenceNumber++;
            txPacket.seq_num = sequenceNumber;
            txPacket.uptime  = currentMillis;

            int ret = snprintf(txPacket.text_data, sizeof(txPacket.text_data),
                               "S:%u %srH2:%u rEtOH:%u",
                               sequenceNumber, slowDataStr, sgp.rawH2, sgp.rawEthanol);
            if (ret < 0 || ret >= (int)sizeof(txPacket.text_data)) {
                dropped_frames.fetch_add(1, std::memory_order_relaxed);
                txPacket.text_data[0] = '\0';
            }

            txPacket.crc32 = crc32_le(0, (uint8_t*)&txPacket, offsetof(struct_message, crc32));

            tx_radio_busy.store(true, std::memory_order_relaxed);
            if (esp_now_send(receiverMAC, (uint8_t*)&txPacket, sizeof(txPacket)) == ESP_OK) {
                LED_ON();
                ledTurnOffTime = millis() + 10;
            } else {
                tx_radio_busy.store(false, std::memory_order_relaxed);
                dropped_frames.fetch_add(1, std::memory_order_relaxed);
                txBackoffUntil = currentMillis + 10; // Zabezpieczenie przed uderzaniem w uwalone radio również dla pakietów TVOC
            }

            if (usedSlowData) slow_dirty = false;
            fast_dirty = false;
        }
    }

    // =========================================================================
    // DEEP SLEEP
    // =========================================================================
    // P-2 FIX: Dodano warunek 'currentMillis >= txBackoffUntil' do warunku snu
    if (myRole == ROLE_TRIGGER_ONLY && currentState == RUNNING) {
        if (!tx_radio_busy.load(std::memory_order_relaxed) &&
            triggerQueueEmpty() && 
            currentMillis >= txBackoffUntil) {
            if (ledTurnOffTime == 0 || currentMillis >= ledTurnOffTime) {
                enterDeepSleep();
            }
        }
    }
}
