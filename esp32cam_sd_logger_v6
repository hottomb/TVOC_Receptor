struct LedPattern { uint16_t on_ms, off_ms; uint8_t count; uint16_t pause_ms; };

enum LedMode {
    LED_OFF_MODE = 0,
    LED_BOOT,           // ●●● ⋯1s    — inicjalizacja
    LED_WIFI_WAIT,      // ● ⋯⋯⋯⋯     — czeka na WiFi/NTP
    LED_NTP_WAIT,       // ●● ⋯1s     — sync NTP
    LED_SD_INIT,        // ●●● ⋯0.5s  — init SD
    LED_AP_INIT,        // ●●●● ⋯1s   — start AP
    LED_RUNNING,        // ● ⋯⋯⋯⋯⋯⋯  — normalna praca (1 co 3s)
    LED_SERVICE_MODE,   // ●○●○       — tryb serwisowy (200ms)
    LED_ERROR_SD,       // ●●●●● ⋯2s  — błąd SD
    LED_ERROR_ESPNOW,   // ●● ⋯0.5s   — błąd radio
    LED_CAPTIVE_PORTAL, // ●●● ⋯2s    — AP bez STA (offline)
    LED_DEADTIME,       // ● ⋯⋯⋯⋯    — cooldown po serwisie
    LED_SD_RECOVERY,    // ●●●●●●● ⋯1s — próba remount SD
};

const LedPattern LED_PATTERNS[] = {
    {0,   0,   0, 0    },  // OFF
    {80,  80,  3, 1000 },  // BOOT
    {150, 850, 0, 0    },  // WIFI_WAIT
    {80,  80,  2, 1000 },  // NTP_WAIT
    {80,  80,  3, 500  },  // SD_INIT
    {80,  80,  4, 1000 },  // AP_INIT
    {200, 2800,0, 0    },  // RUNNING
    {200, 200, 0, 0    },  // SERVICE_MODE
    {80,  80,  5, 2000 },  // ERROR_SD
    {80,  80,  2, 500  },  // ERROR_ESPNOW
    {100, 100, 3, 2000 },  // CAPTIVE_PORTAL
    {100, 1900,0, 0    },  // DEADTIME
    {60,  60,  7, 1000 },  // SD_RECOVERY: ●●●●●●● ⋯1s (szybkie, dużo)
};

LedMode       currentLedMode = LED_BOOT;
uint8_t       ledBlink       = 0;
bool          ledState       = false;
unsigned long ledTimer       = 0;
bool          ledInPause     = false;

void ledUpdate() {
    const LedPattern& p = LED_PATTERNS[currentLedMode];
    if (p.on_ms == 0 && p.off_ms == 0) { digitalWrite(RED_LED_PIN, HIGH); return; }
    unsigned long now = millis(), elapsed = now - ledTimer;
    if (ledInPause) {
        if (elapsed >= p.pause_ms) { ledInPause = false; ledBlink = 0; ledTimer = now; }
        return;
    }
    if (elapsed < (uint16_t)(ledState ? p.on_ms : p.off_ms)) return;
    ledTimer = now;
    if (!ledState && p.count > 0) {
        if (++ledBlink >= p.count) {
            if (p.pause_ms > 0) { ledInPause = true; ledBlink = 0; digitalWrite(RED_LED_PIN, HIGH); return; }
            ledBlink = 0;
        }
    }
    ledState = !ledState;
    digitalWrite(RED_LED_PIN, ledState ? LOW : HIGH);
}

void setLedMode(LedMode mode) {
    if (currentLedMode == mode) return;
    currentLedMode = mode; ledBlink = 0; ledState = false; ledInPause = false;
    ledTimer = millis(); digitalWrite(RED_LED_PIN, HIGH);
}

