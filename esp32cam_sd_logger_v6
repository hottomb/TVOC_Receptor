// =============================================================================
// STRUKTURY DANYCH
//
// struct_message — IDENTYCZNA z nadajnikiem (ESP32-C3). Nie wolno modyfikować.
//   sizeof = 4+4+140+4 = 152B
//   CRC32 obejmuje wszystkie pola przed crc32 (offsetof(struct_message, crc32)).
//
// Identyfikacja typu zdarzenia i modułu nadajnika:
//   event_type  — dedukowany po odbiorze przez parsowanie text_data:
//                 strstr(text_data,"TYPE:TRIGGER") → BTN_PRESS
//                 brak tokenu                      → TVOC
//                 Nadajnik nie zmienia struktury — typ jest w treści wiadomości.
//
//   sender_mac  — MAC nadawcy z parametru callbacku OnDataRecv.
//                 Jedyna pewna metoda identyfikacji spośród 3 modułów.
//                 Przechowywany w QueuedPacket (wrapper kolejki).
//
// Nadajnik może wysyłać 3 warianty text_data:
//   "SEQ:N TYPE:TRIGGER ACTION:CLICK"               — przycisk (kotwica ML)
//   "S:N T:X RH:X AH:X TVOC:X CO2:X rH2:X rEtOH:X" — czujnik 1Hz
//   "S:N rH2:X rEtOH:X"                             — surowe dane 5Hz
// =============================================================================

typedef struct __attribute__((packed)) struct_message {
    uint32_t seq_num;     // numer sekwencyjny (RTC_DATA_ATTR na nadajniku)
    uint32_t uptime;      // millis() nadajnika w chwili wysyłki
    char     text_data[140]; // payload tekstowy — patrz warianty powyżej
    uint32_t crc32;       // CRC32 wszystkich pól przed tym polem
} struct_message;
// sizeof = 4+4+140+4 = 152B — identyczny z nadajnikiem

// Wrapper kolejki: struct_message + MAC nadawcy (6B, z callbacku ESP-NOW)
// QueuedPacket nigdy nie jest wysyłany przez radio — tylko wewnętrznie w RTOS
typedef struct {
    uint8_t        senderMac[6];  // MAC z parametru OnDataRecv
    struct_message payload;
} QueuedPacket;
// sizeof = 6 + 152 = 158B → rxQueue: 48 × 158B = ~7.6KB SRAM

enum CommandType { CMD_NONE, CMD_ROTATE_FILE, CMD_DELETE_FILE, CMD_CLEAR_ALL };
