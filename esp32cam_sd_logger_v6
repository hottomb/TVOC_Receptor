void changeState(SystemState newState) { currentState = newState; stateEnterTime = millis(); }

bool isFileNameSafe(const char* name) {
    if (!name || strlen(name) == 0 || strstr(name, "..")) return false;
    for (size_t i = 0; i < strlen(name); i++) {
        char c = name[i];
        if (!isalnum(c) && c != '.' && c != '_' && c != '-') return false;
    }
    return true;
}

bool checkSDFreeSpace() {
    if (xSemaphoreTake(sdMutex, pdMS_TO_TICKS(1000)) == pdTRUE) {
        uint64_t total = SD_MMC.totalBytes(), used = SD_MMC.usedBytes();
        xSemaphoreGive(sdMutex);
        return (used <= total) && ((total - used) > MIN_FREE_SPACE_BYTES);
    }
    return false;
}

// Unikalna nazwa zapieczętowanego logu: YYYYMMDD_HHMMSS [+ _NNN]
// Musi być wywoływana POD sdMutex (używa SD_MMC.exists())
void makeUniqueSealedName(char* buf, size_t bufSize) {
    struct tm tI;
    char base[52];
    if (getLocalTime(&tI, 0))
        snprintf(base, sizeof(base), "/LOG_SEALED_%04d%02d%02d_%02d%02d%02d",
                 tI.tm_year+1900, tI.tm_mon+1, tI.tm_mday, tI.tm_hour, tI.tm_min, tI.tm_sec);
    else
        snprintf(base, sizeof(base), "/LOG_SEALED_%lu", millis());
    snprintf(buf, bufSize, "%s.csv", base);
    if (!SD_MMC.exists(buf)) return;
    for (int n = 1; n <= 999; n++) {
        snprintf(buf, bufSize, "%s_%03d.csv", base, n);
        if (!SD_MMC.exists(buf)) return;
    }
    snprintf(buf, bufSize, "%s_%lu.csv", base, millis());
}

// Formatuje MAC jako "AA:BB:CC:DD:EE:FF" do bufora 18B
