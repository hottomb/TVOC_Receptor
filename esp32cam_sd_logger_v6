             mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
}

// =============================================================================
// SOFT-RECOVERY SD
// Próbuje odmontować i remontować kartę SD bez pełnego restartu systemu.
// Wywoływana z sdLoggerTask pod sdMutex gdy wykryty błąd zapisu.
// Parametry: logFile (przez referencję) — zostanie zamknięty i ponownie otwarty.
// Zwraca: true jeśli remount się powiódł i plik jest otwarty.
//
// Dlaczego 3 próby z opóźnieniem:
//   Karta SD może mieć chwilową utratę kontaktu (wibracje, brownout).
//   Pierwsze 500ms: kondensatory na linii zasilania rekuperują.
//   Kolejne próby: dają czas FAT driverowi na wewnętrzne resety.
// =============================================================================
bool attemptSDRemount(File& logFile, const char* fileName) {
    const int MAX_REMOUNT_TRIES = 3;
    for (int attempt = 1; attempt <= MAX_REMOUNT_TRIES; attempt++) {
        setLedMode(LED_SD_RECOVERY);
        Serial.printf("[SD-RECOVERY] Próba %d/%d\n", attempt, MAX_REMOUNT_TRIES);

        // Zamknij plik jeśli otwarty
        if (logFile) logFile.close();

        // Odmontuj VFS
        SD_MMC.end();
        vTaskDelay(pdMS_TO_TICKS(500 * attempt)); // Rosnące opóźnienie: 500, 1000, 1500ms

        // Próba remount
        if (SD_MMC.begin("/sdcard", true)) {
            // Sprawdź wolne miejsce
            uint64_t total = SD_MMC.totalBytes(), used = SD_MMC.usedBytes();
            if (used > total || (total - used) < MIN_FREE_SPACE_BYTES) {
                Serial.println("[SD-RECOVERY] Brak miejsca na SD po remount!");
                sdMounted.store(false, std::memory_order_release);
                return false;
            }

            // Ponowne otwarcie pliku logu
            logFile = SD_MMC.open(fileName, FILE_APPEND);
            if (logFile) {
                sdMounted.store(true, std::memory_order_release);
                sdWriteError.store(false, std::memory_order_release);
                Serial.printf("[SD-RECOVERY] OK po próbie %d. Log: %s\n", attempt, fileName);
                return true;
            }
        }
        Serial.printf("[SD-RECOVERY] Próba %d nieudana.\n", attempt);
    }

    // Wszystkie próby wyczerpane
    Serial.println("[FATAL] SD remount nieudany po 3 próbach. Restart sprzętowy.");
    sdMounted.store(false, std::memory_order_release);
    vTaskDelay(pdMS_TO_TICKS(200));
    ESP.restart();
    return false; // Nigdy nie dotrzemy tutaj
}

